NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/smart-language-learning?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CODE_PEPPER=replace-with-another-random-secret-at-least-32-characters
JSON_LIMIT=10mb

# Used only by: npm run seed:user
SEED_USER_NAME=Your name
SEED_USER_CODE=replace-with-your-login-code
SEED_USER_ROLE=admin
